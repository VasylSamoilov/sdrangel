      </property>
      <item>
       <property name="text">
        <string>FLEX</string>
       </property>
      </item>
      <item>
       <property name="text">
        <string>POCSAG</string>
       </property>
      </item>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QWidget" name="queueContainer" native="true">
   <property name="geometry">
    <rect>
     <x>2</x>
     <y>274</y>
     <width>376</width>
     <height>200</height>
    </rect>
   </property>
   <property name="sizePolicy">
    <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
     <horstretch>0</horstretch>
     <verstretch>0</verstretch>
    </sizepolicy>
   </property>
   <property name="windowTitle">
    <string>Queue</string>
   </property>
   <layout class="QVBoxLayout" name="queueLayout">
    <property name="spacing">
     <number>3</number>
    </property>
    <property name="leftMargin">
     <number>2</number>
    </property>
    <property name="topMargin">
     <number>2</number>
    </property>
    <property name="rightMargin">
     <number>2</number>
    </property>
    <property name="bottomMargin">
     <number>2</number>
    </property>
    <item>
     <layout class="QHBoxLayout" name="queueStatusLayout">
      <item>
       <widget class="QLabel" name="status">
        <property name="toolTip">
         <string>State, message being sent, messages waiting, messages sent</string>
        </property>
        <property name="text">
         <string>Idle</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="queueSpacer">
